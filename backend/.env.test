# Dedicated local integration-test environment.
# The database name must end in `_testing`; the test bootstrap refuses any
# other name before performing its clean-database setup.
NODE_ENV=test
PORT=8081

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=4087
DB_NAME=log_pulse_testing
DB_SSL=false
DB_READ_POOL_MAX=2
DB_WRITE_POOL_MAX=2

LOG_RETENTION_DAYS=30
LOG_PARTITION_DAYS_AHEAD=1

# Health must remain public even when authentication is enabled.
AUTH_ENABLED=true
LOADGEN_API_KEY=
LOADGEN_TENANT_PASSWORD=integration-test-password
JWT_SECRET=integration-test-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=7
