NODE_ENV=development
PORT=8080
JSON_BODY_LIMIT=10mb
LOG_RETENTION_DAYS=30
LOG_PARTITION_DAYS_AHEAD=7


DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password_here
DB_NAME=log_pulse
DB_SSL=false
DB_READ_POOL_MAX=5
DB_WRITE_POOL_MAX=20


# Ingestion write-coalescing (see specs/002-performance-optimization) — merges concurrent
# POST /logs writes into fewer, larger COPY calls. A caller's own batch is never split
# across flushes even if it alone exceeds INGEST_COALESCE_MAX_ROWS. Tune via measurement;
# these starting defaults are negligible against the 20-second ingest-to-queryable budget.
INGEST_COALESCE_WINDOW_MS=5
INGEST_COALESCE_MAX_ROWS=2000


# Multi-tenancy / authentication (optional feature — see README "Optional Features")
# AUTH_ENABLED must default to false: unset or false, the service behaves exactly
# as the unauthenticated core service on all four required endpoints.
AUTH_ENABLED=false
# When AUTH_ENABLED=true, this key is idempotently seeded at startup with
# ingest+query permission for one tenant. Leave unset to start with no seeded key.
LOADGEN_API_KEY=
# Login password for the load-generator tenant account (same account that owns
# LOADGEN_API_KEY) — lets you log in as it via POST /tenants/login to inspect
# or manage its seeded key by hand. Change this for anything beyond local
# development or grading.
LOADGEN_TENANT_PASSWORD=please-change-me-in-production
# Signing secret for Tenant access/refresh tokens (self-service register/login/
# API-key endpoints — these work regardless of AUTH_ENABLED). Change this for
# anything beyond local development or grading.
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=7
