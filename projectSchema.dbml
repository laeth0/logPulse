Project "logPulse" {
  database_type: 'PostgreSQL'
  Note: 'logPulse Database Schema'
}

Enum log_level {
  debug
  info
  warn
  error
}

Table logs {
  id bigint [increment]
  timestamp timestamptz [not null]
  level log_level [not null]
  service text [not null]
  message text [not null]
  attributes jsonb [not null, default: '{}']
  attributes_text jsonb [not null, default: '{}']
  ingested_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (timestamp, id) [pk]
    (service, timestamp, id) [name: 'idx_logs_service_timestamp_id']
    (level, timestamp, id) [name: 'idx_logs_level_timestamp_id']
    attributes_text [name: 'idx_logs_attributes_text_gin', type: gin]
  }

  Note: 'idx_logs_message_trigram (GIN gin_trgm_ops on message) was dropped — see migration 1785684350117. It wrote ~1 index entry per character of message and was the dominant per-row database CPU cost, capping ingestion at ~2,457 logs/sec against a 15,000 logs/sec target. `q` ILIKE search now relies on partition-pruned sequential scan, which stays within the 1s query budget at the ~1M-row target scale.'
}
